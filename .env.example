# Telegram bot token from @BotFather.
# The name is deliberately TELEGRAM_BOT_TOKEN and not BOT_TOKEN: gitleaks' stock
# rule keys on the word "telegram" next to the secret (see .gitleaks.toml).
TELEGRAM_BOT_TOKEN=

# Telegram user id of the owner. Always allowed, and the only recipient of
# operational alerts (expired X cookies).
OWNER_ID=

# Comma-separated Telegram user ids allowed to use the bot besides the owner.
# Everyone else gets silence. Every request runs under the owner's X account.
ALLOWED_IDS=

# Proxy for api.telegram.org. Needed where the ISP blocks Telegram;
# leave empty to connect directly.
TELEGRAM_PROXY=http://127.0.0.1:1080

# Proxy for reaching X. Defaults to TELEGRAM_PROXY when empty.
YTDLP_PROXY=

# Netscape-format cookies.txt exported from a browser logged into X.
# Without it only public tweets download (no NSFW, no age-gated, no protected).
# The bot treats this file as read-only input and works from its own copy —
# yt-dlp rewrites whatever cookie file it is given, and this one is the marker
# of "the owner exported a fresh session". Leave the line out entirely (not
# empty) to run without cookies.
COOKIES_FILE=/usr/local/etc/twitter-dl-cookies.txt

# Scratch space for downloads in progress. One subdirectory per request,
# removed when the request finishes either way; also holds the working copy of
# the cookies above.
DOWNLOAD_DIR=/var/tmp/twitter-dl

# Optional delivery for clips too large for Telegram. Each key is the stable id
# shown in Menu; its value is the full import path to the Adapter factory.
# Leave every OVERFLOW_ADAPTERS line commented to run Telegram-only.
OVERFLOW_DEFAULT=none

# OVERFLOW_ADAPTERS__SHARE=twitter_dl.adapters.share:create
# SHARE_RCLONE_BINARY=rclone
# SHARE_RCLONE_CONFIG=/usr/local/etc/twitter-dl-rclone.conf
# SHARE_RCLONE_REMOTE=keenetic:KeeneticShared/twitter-dl
# SHARE_PATH_PREFIX='\\192.168.1.1\KeeneticShared\twitter-dl'

# OVERFLOW_ADAPTERS__YANDEX_DISK=twitter_dl.adapters.yandex_disk:create
# YANDEX_DISK_RCLONE_BINARY=rclone
# YANDEX_DISK_RCLONE_CONFIG=/usr/local/etc/twitter-dl-rclone.conf
# YANDEX_DISK_RCLONE_REMOTE=yandex:twitter-dl

# Requests in the system at once (queued + downloading), seconds allowed per
# request, and the Bot API upload ceiling that splits Chat from Overflow
# delivery. MAX_TG_VIDEO_MB above 50 only makes sense with a local Bot API server.
QUEUE_LIMIT=5
DOWNLOAD_TIMEOUT_S=1800
MAX_TG_VIDEO_MB=50
