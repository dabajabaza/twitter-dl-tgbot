#!/bin/sh

# PROVIDE: twitter_dl
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# The twitter-dl Telegram bot. Enable with:
#   sysrc twitter_dl_enable=YES
#
# Installation (the bot_deploy role renders no templates — it only calls
# `service`):
#   cp deploy/rc.d/twitter_dl /usr/local/etc/rc.d/twitter_dl && chmod 755 ...
# The repository is the source of truth; see docs/ARCHITECTURE.md D13.
#
# Layers of restart, each curing its own ailment:
#   daemon -r            -> the supervisor itself died
#   sdnotify-supervise   -> the bot crashed OR hung (stopped sending WATCHDOG=1)
#   the bot's own code   -> Telegram/proxy unreachable at startup: it waits with
#                           backoff for up to ten minutes instead of exiting, so
#                           its start order relative to sing-box does not matter.
#
# Privileges: daemon and the supervisor run as root, and the supervisor drops
# the bot itself to twitter_dl_runas. `daemon -u` will not do: it would demote
# the supervisor too, and repeated restarts then fail on initgroups.

. /etc/rc.subr

name=twitter_dl
rcvar=twitter_dl_enable
pidfile=/var/run/twitter-dl.pid

load_rc_config $name

: ${twitter_dl_enable:="NO"}
: ${twitter_dl_runas:="twitterdl"}
: ${twitter_dl_home:="/home/twitterdl"}
: ${twitter_dl_envfile:="/usr/local/etc/twitter-dl.env"}

# watchdog-sec is comfortably larger than the bot's own probe interval (30s, see
# __main__.py): one slow probe must not read as a hang.
command=/usr/sbin/daemon
command_args="-r -S -T ${name} -P ${pidfile} \
	/usr/local/sbin/sdnotify-supervise \
	--name twitter-dl \
	--socket ${twitter_dl_home}/notify.sock \
	--user ${twitter_dl_runas} \
	--watchdog-sec 90 \
	--workdir ${twitter_dl_home}/app \
	-- ${twitter_dl_home}/venv/bin/python -m twitter_dl"

start_precmd=twitter_dl_prestart

twitter_dl_prestart()
{
	# Secrets and settings live in a separate file (0600, readable by the bot
	# only). `set -a` is what puts everything read from it into the child
	# process's environment.
	if [ -r "${twitter_dl_envfile}" ]; then
		set -a
		. "${twitter_dl_envfile}"
		set +a
	else
		warn "no ${twitter_dl_envfile} — the bot would get no token"
		return 1
	fi
	# The single-instance lock file: on FreeBSD the guard uses flock rather
	# than an abstract socket, which does not exist here.
	LOCK_FILE="${twitter_dl_home}/twitter-dl.lock"
	export LOCK_FILE
}

run_rc_command "$1"
