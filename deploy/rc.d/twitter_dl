#!/bin/sh

# PROVIDE: twitter_dl
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# Телеграм-бот twitter-dl. Включение:
#   sysrc twitter_dl_enable=YES
#
# Установка (роль bot_deploy шаблонов не рендерит — только зовёт service):
#   cp deploy/rc.d/twitter_dl /usr/local/etc/rc.d/twitter_dl && chmod 755 ...
# Источник правды — репозиторий, см. docs/ARCHITECTURE.md D13.
#
# Слои перезапуска (каждый лечит свою болезнь):
#   daemon -r            → умер сам супервизор
#   sdnotify-supervise   → бот упал ИЛИ завис (перестал слать WATCHDOG=1)
#   код бота             → Telegram/прокси недоступны на старте: ждёт с backoff
#                          до 10 минут, не выходит. Поэтому порядок старта с
#                          sing-box не важен.
#
# Привилегии: daemon и супервизор идут от root, а бота супервизор запускает уже
# от twitter_dl_runas. Через `daemon -u` не выйдет: он разжалует и сам
# супервизор, и повторные рестарты падают на initgroups.

. /etc/rc.subr

name=twitter_dl
rcvar=twitter_dl_enable
pidfile=/var/run/twitter-dl.pid

load_rc_config $name

: ${twitter_dl_enable:="NO"}
: ${twitter_dl_runas:="twitterdl"}
: ${twitter_dl_home:="/home/twitterdl"}
: ${twitter_dl_envfile:="/usr/local/etc/twitter-dl.env"}

# watchdog-sec заметно больше периода пробы бота (30 с, см. __main__.py):
# одна медленная проба не должна читаться как зависание.
command=/usr/sbin/daemon
command_args="-r -S -T ${name} -P ${pidfile} \
	/usr/local/sbin/sdnotify-supervise \
	--name twitter-dl \
	--socket ${twitter_dl_home}/notify.sock \
	--user ${twitter_dl_runas} \
	--watchdog-sec 90 \
	--workdir ${twitter_dl_home}/app \
	-- ${twitter_dl_home}/venv/bin/python -m twitter_dl"

start_precmd=twitter_dl_prestart

twitter_dl_prestart()
{
	# Секреты и настройки лежат отдельным файлом (0600, читает только бот).
	# set -a — чтобы всё прочитанное ушло в окружение дочернего процесса.
	if [ -r "${twitter_dl_envfile}" ]; then
		set -a
		. "${twitter_dl_envfile}"
		set +a
	else
		warn "нет ${twitter_dl_envfile} — бот не получит токен"
		return 1
	fi
	# Файл блокировки «одна копия»: на FreeBSD используется flock, а не
	# абстрактный сокет (его тут нет).
	LOCK_FILE="${twitter_dl_home}/twitter-dl.lock"
	export LOCK_FILE
}

run_rc_command "$1"
